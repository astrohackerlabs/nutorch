{
  "name": "@astrohacker/nutorch-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:images": "bun scripts/process-images.ts",
    "dev": "react-router dev --host 127.0.0.1 --port 4398",
    "preview": "bun server.ts",
    "build": "react-router build && nu scripts/finalize.nu && pagefind --site build/client",
    "typecheck": "react-router typegen && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "check:content": "bun scripts/check-content.ts",
    "check:examples": "nu scripts/check-examples.nu",
    "check:links": "bun scripts/check-links.ts",
    "check:theme": "bun scripts/check-theme.ts",
    "check:flow": "bun scripts/check-shell-tabs.ts",
    "check:ops-ref": "bun scripts/gen-ops-reference.ts --check",
    "check:parity": "nu scripts/check-parity.nu",
    "check:analytics": "bun test app/lib/umami.test.ts app/lib/umami.browser.test.ts",
    "lint": "oxlint --config ../../../oxlint.config.ts --deny-warnings .",
    "format": "oxfmt --threads 1 --config oxfmt.config.mjs --ignore-path ../../../.prettierignore --ignore-path .prettierignore --write .",
    "format:check": "oxfmt --threads 1 --config oxfmt.config.mjs --ignore-path ../../../.prettierignore --ignore-path .prettierignore --check .",
    "lint:fix": "oxlint --config ../../../oxlint.config.ts --deny-warnings --fix ."
  },
  "dependencies": {
    "@astrohacker/ui": "file:vendor/astrohacker-ui",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@react-router/node": "^8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8",
    "gray-matter": "^4.0.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "remark-rehype": "^11.1.2",
    "rehype-stringify": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.5.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pagefind": "1.5.2",
    "playwright": "1.63.0",
    "png-to-ico": "3.0.2",
    "oxfmt": "0.72.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.3",
    "vite-tsconfig-paths": "^6",
    "wrangler": "4.147.0"
  }
}